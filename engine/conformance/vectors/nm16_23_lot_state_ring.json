{
  "format": 1,
  "name": "net_lot_state_ring",
  "spec": ["network-manager 6.2", "network-manager 6.3", "network-manager 16.23"],
  "description": "A 2 x 3 lot at x 10..11, z 20..22 changes state (0xE8BDA2E7): the 6.3 walk over the grown rect {9, 19, 12, 23} starts at (0, 0), so pending gets 61 keys: (0..12, 0); (9, z) and (12, z) for z = 1..22; (9..12, 23); not (10, 19), (11, 19) nor the lot's own 6 cells. ProcessUpdateList runs them in the hash set's order (8.5 replay contract, B = 193: buckets key mod 193 ascending, latest insert first; so (12, 23) and (9, 19), both bucket 7, then (5, 0), bucket 122): the usable streets at (5, 0) (row 0), (9, 19) (column x0) and (12, 23) (bottom row) are styled, the ones at (10, 19) (the top row's inner cell, not visited) and (10, 20) (inside the lot) are not. The lot is released and pending is empty. At the city edge only the cells inside the city are added, (0, 0) included.",
  "steps": [
    {"op": "net_create"},
    {"op": "net_lot", "lot": "0x9999", "rect": [10, 20, 11, 22]},
    {"op": "net_call", "method": "add_border_to_pending", "args": [[9, 19, 12, 23]]},
    {"op": "net_expect", "of": "lots", "state": {"pending_count": 61, "pending": [
      [12, 16], [9, 12], [0, 0], [12, 17], [9, 13], [12, 18], [9, 14], [12, 19], [9, 15], [12, 20],
      [9, 16], [12, 21], [9, 17], [12, 22], [9, 18], [12, 23], [9, 19], [9, 20], [9, 21], [9, 22],
      [9, 23], [10, 0], [7, 0], [4, 0], [1, 0], [10, 23], [11, 0], [8, 0], [5, 0], [2, 0],
      [11, 23], [12, 0], [12, 1], [12, 2], [12, 3], [12, 4], [9, 0], [12, 5], [9, 1], [12, 6],
      [9, 2], [12, 7], [9, 3], [12, 8], [9, 4], [6, 0], [12, 9], [9, 5], [12, 10], [9, 6],
      [12, 11], [9, 7], [12, 12], [9, 8], [3, 0], [12, 13], [9, 9], [12, 14], [9, 10], [12, 15],
      [9, 11]]}},
    {"op": "net_call", "method": "process_update_list"},
    {"op": "net_occupant", "occupant": "0x5F", "flags": ["street", "usable"], "cell": [5, 0]},
    {"op": "net_occupant", "occupant": "0x60", "flags": ["street", "usable"], "cell": [9, 19]},
    {"op": "net_occupant", "occupant": "0x63", "flags": ["street", "usable"], "cell": [10, 19]},
    {"op": "net_occupant", "occupant": "0x61", "flags": ["street", "usable"], "cell": [10, 20]},
    {"op": "net_occupant", "occupant": "0x62", "flags": ["street", "usable"], "cell": [12, 23]},
    {"op": "net_clear_events"},
    {"op": "net_message", "of": "lots", "type": "LotStateChanged", "unknown": "0x9999", "expect": true},
    {"op": "net_expect_events", "filter": {"event": "texture"}, "events": [{"occupant": "0x62"}, {"occupant": "0x60"}, {"occupant": "0x5F"}]},
    {"op": "net_expect", "of": "lots", "state": {"pending": []}},
    {"op": "net_expect_refs", "refs": {"0x9999": 0}},
    {"op": "net_call", "method": "add_border_to_pending", "args": [[-1, -1, 1, 1]]},
    {"op": "net_expect", "of": "lots", "state": {"pending": [[0, 0], [0, 1], [1, 0], [1, 1]]}}
  ]
}
