{
  "format": 1,
  "name": "dt8_02_setters_text",
  "spec": ["dates 1.4", "dates 1.5", "dates 1.6", "dates 8"],
  "description": "Tests 6-9. Previous from 2000-01-01 (a Saturday) for Sunday, Saturday and Monday, and an argument outside 1-7 following the formula (0 goes back 13 days, 8 goes back 5); Set(dayOfYear, y) with year 0 counting from 1901-01-01 and no range check; month names by their first three characters ignoring case, last match wins, no match is January (quirk); [choice] DT2: names shorter than three characters match nothing. DateString of 2000-03-04 in every format family, with %4u padding a short year.",
  "steps": [
    {"op": "dt_fn", "fn": "previous", "args": [2451545, 7], "expect": 2451539},
    {"op": "dt_fn", "fn": "previous", "args": [2451545, 6], "expect": 2451545},
    {"op": "dt_fn", "fn": "previous", "args": [2451545, 1], "expect": 2451540},
    {"op": "dt_fn", "fn": "previous", "args": [2451545, 0], "expect": 2451532},
    {"op": "dt_fn", "fn": "previous", "args": [2451545, 8], "expect": 2451540},
    {"op": "dt_fn", "fn": "set_day_of_year", "args": [0, 0], "expect": 2415386},
    {"op": "dt_fn", "fn": "set_day_of_year", "args": [1, 0], "expect": 2415387},
    {"op": "dt_fn", "fn": "set_day_of_year", "args": [60, 2000], "expect": 2451604},
    {"op": "dt_fn", "fn": "set_day_of_year", "args": [366, 1999], "expect": 2451545},
    {"op": "dt_fn", "fn": "month_from_name", "args": ["march"], "expect": 3},
    {"op": "dt_fn", "fn": "month_from_name", "args": ["MAY"], "expect": 5},
    {"op": "dt_fn", "fn": "month_from_name", "args": ["Smarch"], "expect": 1},
    {"op": "dt_fn", "fn": "month_from_name", "args": ["dEcember"], "expect": 12},
    {"op": "dt_fn", "fn": "month_from_name", "args": ["Ma"], "expect": 1},
    {"op": "dt_new", "obj": "A"},
    {"op": "dt_call", "obj": "A", "method": "set_month_name", "args": ["march", 1, 2000], "expect": 2451605},
    {"op": "dt_call", "obj": "A", "method": "set_month_name", "args": ["Smarch", 1, 2000], "expect": 2451545},
    {"op": "dt_fn", "fn": "date_string", "args": [2451608, 0], "expect": "3/4/2000"},
    {"op": "dt_fn", "fn": "date_string", "args": [2451608, 1], "expect": "3/4/2000"},
    {"op": "dt_fn", "fn": "date_string", "args": [2451608, 4294967295], "expect": "3/4/2000"},
    {"op": "dt_fn", "fn": "date_string", "args": [2451608, 2], "expect": "4/3/2000"},
    {"op": "dt_fn", "fn": "date_string", "args": [2451608, 4], "expect": "4.3.2000"},
    {"op": "dt_fn", "fn": "date_string", "args": [2451608, 7], "expect": "4-3-2000"},
    {"op": "dt_fn", "fn": "date_string", "args": [2451608, 9], "expect": "2000.3.4"},
    {"op": "dt_fn", "fn": "date_string", "args": [2451608, 15], "expect": "2000/3/4"},
    {"op": "dt_fn", "fn": "date_string", "args": [0, 0], "expect": "2/28/2935093"},
    {"op": "dt_fn", "fn": "date_string", "args": [1733115, 0], "expect": "1/2/  33"}
  ]
}
