{
  "format": 1,
  "name": "dt8_01_day_numbers",
  "spec": ["dates 1.1", "dates 1.2", "dates 1.3", "dates 1.4", "dates 8"],
  "description": "Tests 1-5. Jday of the spec's dates, including the year-0 January wrap (quirk) and invalid dates giving 0; Mdy round trip, Mdy(0) = 28 February 2935093 (quirk), WeekDay and DayOfYear; leap years and DaysInYear; FirstDayOfMonth in a leap and a common year and for month 13. Edge cases: the largest day number, day 1721119 (t = 0 in Mdy), the wrap of WeekDay at 2^32 - 1.",
  "steps": [
    {"op": "dt_fn", "fn": "jday", "args": [1, 1, 2000], "expect": 2451545},
    {"op": "dt_fn", "fn": "jday", "args": [1, 1, 1901], "expect": 2415386},
    {"op": "dt_fn", "fn": "jday", "args": [2, 29, 2000], "expect": 2451604},
    {"op": "dt_fn", "fn": "jday", "args": [12, 31, 1999], "expect": 2451544},
    {"op": "dt_fn", "fn": "jday", "args": [3, 1, 2000], "expect": 2451605},
    {"op": "dt_fn", "fn": "jday", "args": [10, 15, 1582], "expect": 2299161},
    {"op": "dt_fn", "fn": "jday", "args": [1, 1, 2100], "expect": 2488070},
    {"op": "dt_fn", "fn": "jday", "args": [3, 1, 0], "expect": 1721120},
    {"op": "dt_fn", "fn": "jday", "args": [1, 1, 0], "expect": 1043250630},
    {"op": "dt_fn", "fn": "jday", "args": [2, 29, 1900], "expect": 0},
    {"op": "dt_fn", "fn": "jday", "args": [13, 1, 2000], "expect": 0},
    {"op": "dt_fn", "fn": "jday", "args": [0, 1, 2000], "expect": 0},
    {"op": "dt_fn", "fn": "jday", "args": [2, 0, 2000], "expect": 0},
    {"op": "dt_fn", "fn": "jday", "args": [4, 31, 2000], "expect": 0},
    {"op": "dt_fn", "fn": "day_within_month", "args": [2, 29, 2000], "expect": true},
    {"op": "dt_fn", "fn": "day_within_month", "args": [2, 29, 2100], "expect": false},
    {"op": "dt_fn", "fn": "mdy", "args": [2451604], "expect": [2, 29, 2000]},
    {"op": "dt_fn", "fn": "weekday", "args": [2451604], "expect": 2},
    {"op": "dt_fn", "fn": "day_of_year", "args": [2451604], "expect": 60},
    {"op": "dt_fn", "fn": "weekday", "args": [2451545], "expect": 6},
    {"op": "dt_fn", "fn": "day_of_year", "args": [2451545], "expect": 1},
    {"op": "dt_fn", "fn": "day_of_year", "args": [2451544], "expect": 365},
    {"op": "dt_fn", "fn": "mdy", "args": [0], "expect": [2, 28, 2935093]},
    {"op": "dt_fn", "fn": "weekday", "args": [0], "expect": 1},
    {"op": "dt_fn", "fn": "weekday", "args": [4294967295], "expect": 7},
    {"op": "dt_fn", "fn": "mdy", "args": [1721120], "expect": [3, 1, 0]},
    {"op": "dt_fn", "fn": "mdy", "args": [2488070], "expect": [1, 1, 2100]},
    {"op": "dt_fn", "fn": "leap_year", "args": [2000], "expect": true},
    {"op": "dt_fn", "fn": "leap_year", "args": [2400], "expect": true},
    {"op": "dt_fn", "fn": "leap_year", "args": [0], "expect": true},
    {"op": "dt_fn", "fn": "leap_year", "args": [1900], "expect": false},
    {"op": "dt_fn", "fn": "leap_year", "args": [2100], "expect": false},
    {"op": "dt_fn", "fn": "days_in_year", "args": [1999], "expect": 365},
    {"op": "dt_fn", "fn": "days_in_year", "args": [2000], "expect": 366},
    {"op": "dt_fn", "fn": "first_day_of_month", "args": [2451700, 3], "expect": 61},
    {"op": "dt_fn", "fn": "first_day_of_month", "args": [2451700, 2], "expect": 32},
    {"op": "dt_fn", "fn": "first_day_of_month", "args": [2451700, 13], "expect": 0},
    {"op": "dt_fn", "fn": "first_day_of_month", "args": [2451300, 3], "expect": 60}
  ]
}
