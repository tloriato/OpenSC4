{
  "format": 1,
  "name": "dt8_04_daylight_time",
  "spec": ["dates 2.1", "dates 2.2", "dates 2.3", "dates 8", "crime 9"],
  "description": "Test 11 and section 2 with US Central (_timezone 21600, _daylight 1). BeginDST 2000-04-02, 1996-04-07, 1990-04-08 (1 April a Sunday, quirk), 1974 and 1975 special starts; EndDST 2000-10-29 and 1990-10-28; begin 2000 = 02:00 + 6 h 3132115200. _daylight 0: never daylight. cRZTime(date, h, m, s): crime.md 9's worked example 2026-10-14 12:00 = 3969450000; 2026-10-28 one hour later in the library rule; 02:30 on 2000-04-02 in the spring-forward hour gives 0 (quirk); LocalSecs / Hour / Minute read back; Set(time) the local date; time 0 gives date 0.",
  "steps": [
    {"op": "dt_fn", "fn": "begin_dst_day", "args": [2000], "tz": {"timezone": 21600, "daylight": 1}, "expect": [4, 2, 2000]},
    {"op": "dt_fn", "fn": "begin_dst_day", "args": [1996], "tz": {"timezone": 21600, "daylight": 1}, "expect": [4, 7, 1996]},
    {"op": "dt_fn", "fn": "begin_dst_day", "args": [1990], "tz": {"timezone": 21600, "daylight": 1}, "expect": [4, 8, 1990]},
    {"op": "dt_fn", "fn": "begin_dst_day", "args": [1974], "tz": {"timezone": 21600, "daylight": 1}, "expect": [1, 6, 1974]},
    {"op": "dt_fn", "fn": "begin_dst_day", "args": [1975], "tz": {"timezone": 21600, "daylight": 1}, "expect": [2, 23, 1975]},
    {"op": "dt_fn", "fn": "end_dst_day", "args": [2000], "tz": {"timezone": 21600, "daylight": 1}, "expect": [10, 29, 2000]},
    {"op": "dt_fn", "fn": "end_dst_day", "args": [1990], "tz": {"timezone": 21600, "daylight": 1}, "expect": [10, 28, 1990]},
    {"op": "dt_fn", "fn": "begin_dst", "args": [2000], "tz": {"timezone": 21600, "daylight": 1}, "expect": 3132115200},
    {"op": "dt_fn", "fn": "is_dst", "args": [3132115199], "tz": {"timezone": 21600, "daylight": 1}, "expect": false},
    {"op": "dt_fn", "fn": "is_dst", "args": [3132115200], "tz": {"timezone": 21600, "daylight": 1}, "expect": true},
    {"op": "dt_fn", "fn": "is_dst", "args": [3132115200], "tz": {"timezone": 21600, "daylight": 0}, "expect": false},
    {"op": "dt_fn", "fn": "time_from_local", "args": [2461328, 12, 0, 0], "tz": {"timezone": 21600, "daylight": 1}, "expect": 3969450000},
    {"op": "dt_fn", "fn": "time_from_local", "args": [2461342, 12, 0, 0], "tz": {"timezone": 21600, "daylight": 1}, "expect": 3970663200},
    {"op": "dt_fn", "fn": "time_from_local", "args": [2451637, 2, 30, 0], "tz": {"timezone": 21600, "daylight": 1}, "expect": 0},
    {"op": "dt_fn", "fn": "time_from_local", "args": [2451637, 3, 0, 0], "tz": {"timezone": 21600, "daylight": 1}, "expect": 3132115200},
    {"op": "dt_fn", "fn": "time_from_local", "args": [2451637, 2, 30, 0], "tz": {"timezone": 21600, "daylight": 0}, "expect": 3132117000},
    {"op": "dt_fn", "fn": "time_from_local", "args": [0, 12, 0, 0], "tz": {"timezone": 21600, "daylight": 1}, "expect": 0},
    {"op": "dt_fn", "fn": "time_from_local", "args": [2440588, 0, 0, 0], "expect": 2177452800},
    {"op": "dt_fn", "fn": "time_hour", "args": [3969450000], "tz": {"timezone": 21600, "daylight": 1}, "expect": 12},
    {"op": "dt_fn", "fn": "time_minute", "args": [3969451800], "tz": {"timezone": 21600, "daylight": 1}, "expect": 30},
    {"op": "dt_fn", "fn": "time_local_secs", "args": [3969450000], "tz": {"timezone": 21600, "daylight": 1}, "expect": 3969432000},
    {"op": "dt_fn", "fn": "time_date", "args": [3969450000], "tz": {"timezone": 21600, "daylight": 1}, "expect": 2461328},
    {"op": "dt_fn", "fn": "time_date", "args": [0], "tz": {"timezone": 21600, "daylight": 1}, "expect": 0},
    {"op": "dt_new", "obj": "A", "day": 7},
    {"op": "dt_call", "obj": "A", "method": "set_time", "args": [3969450000], "tz": {"timezone": 21600, "daylight": 1}, "expect": 2461328},
    {"op": "dt_call", "obj": "A", "method": "set_time", "args": [0], "expect": 0}
  ]
